{
  "name": "@kin/core",
  "version": "0.1.4",
  "private": true,
  "description": "KIN Core — Local service for chats, projects, and agent workflows",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc && node -e \"import('node:fs').then(fs => { fs.mkdirSync('dist/storage', {recursive:true}); fs.copyFileSync('src/storage/schema.sql', 'dist/storage/schema.sql'); })\"",
    "dev": "tsc -w",
    "daemon": "node dist/start_daemon.js",
    "package:binary": "node scripts/package_binary.js",
    "test": "vitest run --fileParallelism=false --pool=threads",
    "test:foundation": "vitest run test/foundation.test.ts",
    "test:e2e": "vitest run test/e2e_browser_app.test.ts test/e2e_18_layer_production_verification.test.ts test/e2e_production_harness.test.ts --fileParallelism=false --pool=threads"
  },
  "dependencies": {
    "puppeteer-core": "^25.12.0",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@types/uuid": "^10.0.0",
    "esbuild": "^0.25.0",
    "postject": "^1.0.0-alpha.6",
    "typescript": "^5.8.2",
    "vitest": "^3.0.7"
  }
}
