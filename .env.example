# KIN Environment Configuration Template
# Optional: Set OpenRouter API key for cloud LLMs (free models available without key via local Ollama)
OPENROUTER_API_KEY=

# Optional: Set NVIDIA NIM API key for NVIDIA-hosted models (Nemotron, Llama 3.1/3.3, DeepSeek R1)
# Sign up at https://build.nvidia.com to obtain an API key (format: nvapi-...)
NVIDIA_NIM_API_KEY=

# Port for local workforce daemon (default: 54321)
KIN_PORT=54321

# Local Ollama endpoint (default: http://127.0.0.1:11434)
OLLAMA_BASE_URL=http://127.0.0.1:11434
