# KIN Environment Variables (all optional unless using specific cloud providers)

# --- Core Server & Storage ---
# KIN_PORT=54321
# KIN_DATA_DIR=
# KIN_DB_PATH=
# KIN_HOME=
# KIN_VAULT_KEY=
# KIN_DEFAULT_MODEL=

# --- Local Inference (Ollama) ---
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_BASE_URL=http://127.0.0.1:11434
# KIN_OLLAMA_TIMEOUT_MS=180000
# KIN_OLLAMA_NUM_CTX=8192

# --- Cloud LLM Providers (BYOK) ---
OPENROUTER_API_KEY=
NVIDIA_NIM_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# DEEPSEEK_API_KEY=
# GROQ_API_KEY=
# XAI_API_KEY=
# TOGETHER_API_KEY=
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_ENDPOINT=

# --- OAuth Connectors ---
# KIN_GITHUB_CLIENT_ID=
# KIN_GITHUB_CLIENT_SECRET=
# KIN_GOOGLE_CLIENT_ID=
# KIN_SLACK_CLIENT_ID=

# --- Browser & Desktop Control ---
# KIN_HEADLESS=true
# KIN_BROWSER_PATH=
# KIN_POWERSHELL_TIMEOUT_MS=15000

# --- Watchdog ---
# KIN_WATCH_PARENT=true
# KIN_NO_PARENT_WATCHDOG=0
# KIN_WATCHDOG_INTERVAL_MS=2500
