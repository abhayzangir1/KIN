{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "KIN",
  "version": "0.1.0",
  "identifier": "com.kin.workforce",
  "build": {
    "frontendDist": "../ui/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev --workspace=ui",
    "beforeBuildCommand": "npm run build --workspace=ui"
  },
  "app": {
    "windows": [
      {
        "title": "KIN — Autonomous AI Workforce Platform",
        "width": 1400,
        "height": 900,
        "minWidth": 1000,
        "minHeight": 650,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
